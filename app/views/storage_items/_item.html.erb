<div id="storage_item_<%= item.id || 'new' %>" class="p-4 border border-gray-200 rounded-lg space-y-4">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Registreringsnummer</label>
      <input type="text" 
             name="rental_agreement[storage_items_attributes][<%= item.id || 'new' %>][registration_number]"
             value="<%= item.registration_number %>"
             class="w-full px-3 py-2 border border-gray-300 rounded-md"
             placeholder="AB12345"
             data-action="change->items#lookupVehicle" 
             data-items-target="registrationNumber">
    </div>
    
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Beskrivelse</label>
      <input type="text" 
             name="rental_agreement[storage_items_attributes][<%= item.id || 'new' %>][description]"
             value="<%= item.description %>"
             class="w-full px-3 py-2 border border-gray-300 rounded-md"
             placeholder="Båt på henger">
    </div>
    
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Antall meter</label>
      <input type="number" 
             name="rental_agreement[storage_items_attributes][<%= item.id || 'new' %>][meters]"
             value="<%= item.meters %>"
             class="w-full px-3 py-2 border border-gray-300 rounded-md"
             step="0.01" 
             min="0"
             data-action="change->items#calculateTotal" 
             data-items-target="meters">
    </div>
  </div>
  
  <button type="button" 
          data-action="click->items#removeItem" 
          data-item-id="<%= item.id || 'new' %>"
          class="text-red-500 hover:text-red-700 text-sm">
    Fjern
  </button>
</div>
