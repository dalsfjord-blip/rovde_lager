<% content_for :title, "Vinterlagring | Rovde Industripark" %>

<section class="flex flex-col gap-10 text-center text-white sm:gap-14">
  <%= link_to "← Til framsida", root_path, class: "inline-block text-sm font-semibold text-white/80 transition hover:text-white" %>

  <div class="space-y-4">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-white/75"></p>
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Vinterlagring</h1>
    <p class="text-lg leading-8 text-white/85">Trygg lagring av båt og køyretøy gjennom vinteren.</p>
  </div>

  <div class="space-y-5">
    <div class="space-y-3">
      <h2 class="text-2xl font-semibold"></h2>
      <p class="text-base leading-7 text-white/85">Sjå Facebook for meir informasjon om årets vinterlagring.</p>
    </div>
    <%= link_to "Sjå informasjon på Facebook", "https://www.facebook.com/share/1F7zVbZ5we/?mibextid=wwXIf", target: "_blank", rel: "noopener noreferrer", class: "inline-block border border-white/75 px-6 py-3 text-sm font-semibold uppercase tracking-[0.12em] transition hover:bg-white hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-slate-950" %>
  </div>

  <div style="margin-top: 150px; padding-top: 60px;" class="border-t border-white/40 text-left">
    <div class="space-y-2 text-center">
      <h2 class="text-xl font-semibold">For tilsette</h2>
      <p class="text-sm leading-6 text-white/85">Logg inn med PIN-kode for å registrere vinterlagring.</p>
    </div>

    <%= form_with url: sessions_path, method: :post, html: { style: "max-width: 220px;", class: "mx-auto mt-6 space-y-5 text-center" } do |f| %>
      <div>
        <%= f.label :pin, "PIN-kode", class: "block text-sm font-medium text-white mb-2" %>
        <%= f.password_field :pin,
              class: "w-full border border-white/75 bg-white/10 px-4 py-2.5 text-center text-white outline-none transition placeholder:text-white/60 focus:border-white focus:ring-2 focus:ring-white",
              autocomplete: "current-password",
              inputmode: "numeric",
              pattern: "[0-9]*",
              placeholder: "" %>
      </div>

      <%= f.submit "Logg inn", class: "w-full cursor-pointer bg-white/20 py-2.5 px-4 font-medium text-white hover:bg-white/30 transition border border-white/60" %>
    <% end %>

    <% if flash[:alert] %>
      <p class="mx-auto mt-5 max-w-sm border border-red-200 bg-red-950/60 px-4 py-3 text-sm text-white"><%= flash[:alert] %></p>
    <% end %>
  </div>
</section>