# Resend API configuration for local testing
# Copy this file to .env.development and add your actual API key
RESEND_API_KEY=your_resend_api_key_here
SMTP_FROM_EMAIL=avtale@rovdeindustripark.app
USE_RESEND=true
INVOICE_FROM_EMAIL=faktura@rovdeindustripark.app
ACCOUNTING_EMAIL=rovdeindustri@faktura.poweroffice.net
VIPPS_CLIENT_ID=your_vipps_client_id
VIPPS_CLIENT_SECRET=your_vipps_client_secret
VIPPS_SUBSCRIPTION_KEY=your_vipps_subscription_key
VIPPS_MERCHANT_SERIAL_NUMBER=your_vipps_merchant_serial_number
VIPPS_WEBHOOK_SECRET=your_vipps_webhook_secret
VIPPS_BASE_URL=https://apitest.vipps.no
APP_HOST=localhost:3000
