<div class="max-w-2xl mx-auto p-6">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-800">Del 3: Betaling</h1>
    <%= link_to "Tilbake", contract_path, class: "bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-md text-sm" %>
  </div>

  <div class="bg-white p-6 rounded-lg shadow-sm mb-6">
    <h2 class="text-xl font-semibold mb-4 text-gray-700">Betaling</h2>
    
    <div class="space-y-4">
      <%= form_with url: payment_path, method: :post, class: "space-y-4" do |f| %>
        
        <%= f.hidden_field :payment_method, value: "vipps", id: "payment_method" %>

        <div class="bg-gray-50 p-4 rounded-lg">
          <h3 class="font-semibold mb-2 text-gray-700">Sammendrag</h3>
          <p class="text-gray-700">Total: <%= number_to_currency(@agreement.total_price || 0) %></p>
        </div>

        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
          <p class="text-sm text-blue-800">
            <strong>ℹ️ Betaling via Vipps</strong><br>
            Du blir sendt til Vipps for å fullføre betalingen. Kvittering mottar du i Vipps-appen.
          </p>
        </div>

        <%= f.submit "Betal med Vipps", 
              class: "w-full bg-[#FF5B24] hover:bg-[#e6501f] text-white px-6 py-3 rounded-lg text-lg font-medium" %>
        
        <% if Rails.env.development? %>
          <p class="text-xs text-gray-500 text-center">(Simulert betaling i utvikling)</p>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
