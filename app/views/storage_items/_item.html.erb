<div id="storage_item_<%= f.object.id || 'new' %>" class="p-4 border border-gray-200 rounded-lg space-y-4">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div>
      <%= f.label :registration_number, "Registreringsnummer", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :registration_number, 
            class: "w-full px-3 py-2 border border-gray-300 rounded-md",
            placeholder: "AB12345",
            data: { action: "change->items#lookupVehicle", items_target: "registrationNumber" } %>
    </div>
    
    <div>
      <%= f.label :description, "Beskrivelse", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :description, 
            class: "w-full px-3 py-2 border border-gray-300 rounded-md",
            placeholder: "Båt på henger" %>
    </div>
    
    <div>
      <%= f.label :meters, "Antall meter", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :meters, 
            class: "w-full px-3 py-2 border border-gray-300 rounded-md",
            step: "0.01", 
            min: "0",
            data: { action: "change->items#calculateTotal", items_target: "meters" } %>
    </div>
  </div>
  
  <% if f.object.persisted? %>
    <%= f.hidden_field :id %>
    <%= link_to "Fjern", remove_item_storage_items_path(f.object.id), 
          method: :delete,
          data: { turbo_method: :delete },
          class: "text-red-500 hover:text-red-700 text-sm" %>
  <% else %>
    <button type="button" 
            data-action="click->items#removeItem"
            data-item-id="new"
            class: "text-red-500 hover:text-red-700 text-sm">
      Fjern
    </button>
  <% end %>
</div>
