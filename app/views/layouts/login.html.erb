<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Vinterlagring | Rovde Industripark" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body class="min-h-screen bg-slate-950">
    <main class="relative isolate min-h-screen overflow-hidden bg-slate-950 px-6 py-12 sm:px-8 sm:py-16">
      <%= image_tag "main_img.png", alt: "Rovde Industripark", class: "absolute inset-0 -z-20 h-full w-full object-cover" %>
      <div class="absolute inset-0 -z-10 bg-slate-950/70"></div>

      <div class="mx-auto w-full max-w-xl">
        <%= yield %>
      </div>
    </main>
  </body>
</html>
